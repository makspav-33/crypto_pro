# Copy to .env in the project root. Restart both servers after changes.
APP_NAME=DigitalVault
DATABASE_PATH=backend/data/digitalvault.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required: paste the generated value below in your private .env.
JWT_SECRET=
JWT_TTL_MINUTES=15
